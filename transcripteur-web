#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

source "$SCRIPT_DIR/venv/bin/activate"

export LD_LIBRARY_PATH="$("$SCRIPT_DIR/venv/bin/python" - <<'PY'
import site
import glob
import os

paths = []

for root in site.getsitepackages():
    paths += glob.glob(os.path.join(root, "nvidia", "*", "lib"))

print(":".join(paths))
PY
):${LD_LIBRARY_PATH:-}"

exec python "$SCRIPT_DIR/web_app.py"
